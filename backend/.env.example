# Example environment variables for Learniverse backend
# Do NOT commit real secrets. Use a secrets manager in production.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/learniverse
# One shared pool per backend worker; hard caps are min=5 and max=20.
DB_POOL_MIN_CONNS=1
DB_POOL_MAX_CONNS=10

# Model / API keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=tencent/hy3:free

# Execution service
JUDGE0_URL=
JUDGE0_API_KEY=
ALLOW_LOCAL_EXECUTION=false
PISTON_FALLBACK_ENABLED=false

# App mode
ENV=development

# Other
SENTRY_DSN=
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
ADMIN_USERNAMES=
ADMIN_PASSWORD_HASH=
STUDENT_ROSTER_PATH=

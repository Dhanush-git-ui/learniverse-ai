# Example environment variables for Learniverse backend
# Do NOT commit real secrets. Use a secrets manager in production.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/learniverse

# Model / API keys
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Execution service
JUDGE0_URL=
JUDGE0_API_KEY=
ALLOW_LOCAL_EXECUTION=false

# App mode
ENV=development

# Other
SENTRY_DSN=
